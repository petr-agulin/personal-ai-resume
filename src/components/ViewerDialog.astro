---
// The certificate pop-up. Scripts fill in the title and the image or PDF of
// whichever "View" link was clicked. Without JavaScript those links simply
// open the file in a new tab.
import type { Lang } from "../content/schema.ts";
import { t } from "../i18n/index.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
---

<dialog id="viewer" class="modal modal--viewer" aria-labelledby="viewer-title">
  <div class="modal__header modal__header--compact">
    <div class="modal__heading">
      <h3 id="viewer-title" class="viewer__title"></h3>
      <div class="viewer__subtitle"></div>
    </div>
    <button class="modal__close" type="button" aria-label={s.close} data-close>×</button>
  </div>
  <div class="viewer__media"></div>
</dialog>
